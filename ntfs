set -euo pipefail

VERSION="1.1.0"
MOUNT_RECORD="${HOME:-/var/root}/.ntfs-mounts"
DAEMON_MOUNT_RECORD="${HOME:-/var/root}/.ntfs-mounts-daemon"
DAEMON_PLIST="${HOME:-/var/root}/Library/LaunchAgents/com.ntfshandler.automount.plist"
DAEMON_LOG="${HOME:-/var/root}/Library/Logs/ntfs-daemon.log"
DAEMON_OLD_PLIST="/Library/LaunchDaemons/com.ntfshandler.automount.plist"
# Bumped whenever the sudoers whitelist changes — the daemon-install check
# refuses to start if the user's sudoers file is from an older version.
SUDOERS_VERSION="6"
# Absolute path to this script. Privileged work is re-entered through it via
# sudo (see __mount_helper), so the sudoers rule can whitelist one validated
# entry point rather than ntfs-3g with unrestricted arguments. Only the
# installed copy at /usr/local/bin/ntfs matches the rule; running from a
# checkout falls back to a normal password prompt.
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# ── Colors ───────────────────────────────────────────────────────────────────
if [ -t 1 ] && [ "${NO_COLOR:-}" = "" ]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
    BLUE=$'\033[0;34m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; NC=$'\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; BLUE=''; CYAN=''; BOLD=''; DIM=''; NC=''
fi

# ── Logging ──────────────────────────────────────────────────────────────────
info() { printf "${BLUE}=>${NC} %s\n" "$*"; }
ok()   { printf "${GREEN}✓${NC}  %s\n" "$*"; }
warn() { printf "${YELLOW}▲${NC}  %s\n" "$*" >&2; }
err()  { printf "${RED}✗${NC}  %s\n" "$*" >&2; }
die()  { err "$*"; exit 1; }

# ── Dependency Check ─────────────────────────────────────────────────────────
check_deps() {
    local all_ok=1
    if ! command -v ntfs-3g &>/dev/null; then
        err "ntfs-3g not found"
        printf "  Install: ${BOLD}brew install gromgit/fuse/ntfs-3g-mac${NC}\n" >&2
        all_ok=0
    fi
    if ! { [ -d /Library/Filesystems/macfuse.fs ] || [ -d /Library/Filesystems/osxfuse.fs ]; }; then
        err "macFUSE not detected"
        printf "  Install: https://osxfuse.github.io/\n" >&2
        all_ok=0
    fi
    [ "$all_ok" -eq 1 ]
}

# ── ntfs-3g path detection ────────────────────────────────────────────────────
find_ntfs3g() {
    local c
    for c in \
        "$(command -v ntfs-3g 2>/dev/null || true)" \
        /opt/homebrew/bin/ntfs-3g \
        /usr/local/bin/ntfs-3g; do
        [ -x "$c" ] && echo "$c" && return 0
    done
    return 1
}

# ── diskutil plist helper ─────────────────────────────────────────────────────
# Use structured plist output so macOS updates to diskutil's human-readable
# format don't silently break volume detection.
diskutil_plist_key() {
    diskutil info -plist "$1" 2>/dev/null | plutil -extract "$2" raw - 2>/dev/null || true
}

# ── NTFS Volume Detection ─────────────────────────────────────────────────────
# Populates globals: NTFS_DISKS  NTFS_VOLNAMES  NTFS_SIZES
NTFS_DISKS=()
NTFS_VOLNAMES=()
NTFS_SIZES=()

find_ntfs_volumes() {
    NTFS_DISKS=(); NTFS_VOLNAMES=(); NTFS_SIZES=()
    local disk_id fs_type vol_name size_bytes size_str

    while IFS= read -r disk_id; do
        [ -z "$disk_id" ] && continue
        diskutil info "$disk_id" &>/dev/null || continue

        fs_type=$(diskutil_plist_key "$disk_id" FilesystemType)
        [[ "$fs_type" == *ntfs* ]] || continue

        vol_name=$(diskutil_plist_key "$disk_id" VolumeName)
        if [ -z "$vol_name" ] || [ "$vol_name" = "Not applicable" ]; then
            vol_name="NTFS Volume"
        fi

        size_bytes=$(diskutil_plist_key "$disk_id" TotalSize)
        size_str=$(awk -v b="${size_bytes:-0}" 'BEGIN {
            if (b >= 1e12)     printf "%.1f TB", b/1e12
            else if (b >= 1e9) printf "%.1f GB", b/1e9
            else if (b >= 1e6) printf "%.1f MB", b/1e6
            else               printf "%d B",    b }')
        [ -z "$size_str" ] && size_str="?"

        NTFS_DISKS+=("$disk_id")
        NTFS_VOLNAMES+=("$vol_name")
        NTFS_SIZES+=("$size_str")
    done < <(diskutil list 2>/dev/null | awk '/Microsoft Basic Data|Windows_NTFS/ {print $NF}')
}

# ── Mount Record ──────────────────────────────────────────────────────────────
# Populates globals: REC_DISKS  REC_MOUNTS
REC_DISKS=()
REC_MOUNTS=()

load_mount_record() {
    REC_DISKS=(); REC_MOUNTS=()
    local f disk_id mount_point already j

    for f in "$MOUNT_RECORD" "$DAEMON_MOUNT_RECORD"; do
        [ -f "$f" ] || continue
        while IFS=$'\t' read -r disk_id mount_point; do
            [ -n "$disk_id" ] && [ -n "$mount_point" ] || continue
            already=0
            for ((j=0; j<${#REC_DISKS[@]}; j++)); do
                [ "${REC_DISKS[$j]}" = "$disk_id" ] && { already=1; break; }
            done
            [ "$already" -eq 0 ] && {
                REC_DISKS+=("$disk_id")
                REC_MOUNTS+=("$mount_point")
            }
        done < "$f"
    done
    return 0
}

# ── Record-file locking ─────────────────────────────────────────────────────────
# The user commands and the auto-mount agent can both touch the daemon record
# file at once (e.g. the agent records a new mount while `ntfs status` prunes a
# stale entry). Serialize each read-modify-write with an atomic mkdir mutex so a
# concurrent update can't clobber the other's change. mkdir is atomic on POSIX
# filesystems; macOS ships no flock(1). Reads (load_mount_record) need no lock —
# the atomic `mv` means a reader always sees a complete file.
record_lock() {
    local lock="$1.lock" waited=0
    until mkdir "$lock" 2>/dev/null; do
        waited=$((waited + 1))
        # After ~2s assume the holder died mid-update and steal the lock.
        [ "$waited" -ge 20 ] && rm -rf "$lock" 2>/dev/null || true
        sleep 0.1
    done
}

record_unlock() {
    rmdir "$1.lock" 2>/dev/null || true
}

record_mount() {
    local disk_id="$1" mount_point="$2" record_file="${3:-$MOUNT_RECORD}"
    local tmp; tmp=$(mktemp)
    record_lock "$record_file"
    [ -f "$record_file" ] && grep -v "^${disk_id}	" "$record_file" > "$tmp" 2>/dev/null || true
    printf '%s\t%s\n' "$disk_id" "$mount_point" >> "$tmp"
    mv "$tmp" "$record_file" 2>/dev/null || { rm -f "$tmp" 2>/dev/null || true; record_unlock "$record_file"; return 1; }
    record_unlock "$record_file"
}

record_unmount() {
    local disk_id="$1" f tmp
    for f in "$MOUNT_RECORD" "$DAEMON_MOUNT_RECORD"; do
        [ -f "$f" ] || continue
        record_lock "$f"
        tmp=$(mktemp)
        grep -v "^${disk_id}	" "$f" > "$tmp" 2>/dev/null || true
        if mv "$tmp" "$f" 2>/dev/null; then
            [ -f "$f" ] && [ ! -s "$f" ] && rm -f "$f"
        else
            rm -f "$tmp" 2>/dev/null || true
        fi
        record_unlock "$f"
    done
    return 0
}

# ── Helpers ───────────────────────────────────────────────────────────────────
safe_name() {
    # Strip only / and : (the chars that break mount paths) plus control chars.
    # Leave Unicode intact so international drive names stay human-readable.
    printf '%s' "$1" \
        | sed 's|[/:]||g; s/[[:cntrl:]]//g; s/ /_/g; s/__*/_/g; s/^_//; s/_$//'
}

get_mount_point() {
    local vol_name="$1" disk_id="$2"
    local base safe
    safe=$(safe_name "$vol_name")
    base="/Volumes/${safe:-$disk_id}"
    local mp="$base" i=2
    # Skip any existing directory (mounted or ghost with leftover files);
    # ntfs-3g refuses to mount on a non-empty directory.
    while [ -d "$mp" ]; do
        mp="${base}_${i}"; i=$((i+1))
    done
    echo "$mp"
}

mount_status() {
    # Returns: "rw", "ro", or ""
    local disk_id="$1"
    local mline
    mline=$(mount 2>/dev/null | grep "^/dev/${disk_id} on " || true)
    [ -z "$mline" ] && return 0
    if echo "$mline" | grep -q "read-only"; then
        echo "ro"
    else
        echo "rw"
    fi
}

# ── Privileged helpers (re-entered via sudo) ─────────────────────────────────
# ntfs-3g takes "<device|image_file> <mount_point>", so whitelisting it in
# sudoers with unrestricted arguments would let any listed user mount
# attacker-supplied content over an arbitrary directory as root. These helpers
# are the only privileged entry points: they validate their arguments and build
# the option string themselves, so a caller can influence only the volume name
# and the uid/gid, never which options are set.
__mount_helper() {
    local device="$1" mount_point="$2" uid="$3" gid="$4" ro="$5" nobrowse="$6" vol_name="$7"
    local recover="${8:-}"

    [[ "$device"      =~ ^/dev/disk[0-9]+s[0-9]+$ ]] || die "Refusing: bad device '$device'"
    [[ "$mount_point" =~ ^/Volumes/[^/]+$         ]] || die "Refusing: bad mount point '$mount_point'"
    [[ "$uid" =~ ^[0-9]+$ && "$gid" =~ ^[0-9]+$   ]] || die "Refusing: bad uid/gid"

    local ntfs3g
    ntfs3g=$(find_ntfs3g) || die "ntfs-3g not found"

    # noappledouble: prevent macFUSE from creating ._ AppleDouble files which
    # blocks Finder during move-to-trash. local removed: with it, macOS uses
    # on-volume .Trashes/<uid>/, triggering an auto_xattr write into NTFS ADS
    # that locks the FUSE channel indefinitely. Without local, deletes go
    # through directly (note: deleted files don't go to Trash).
    # Commas are stripped from the volume name so it can't introduce an option.
    local opts="allow_other,auto_xattr,noappledouble,windows_names"
    opts="${opts},uid=${uid},gid=${gid},volname=${vol_name//,/}"
    [ "$ro"       = "1" ]       && opts="${opts},ro"
    [ "$nobrowse" = "1" ]       && opts="${opts},nobrowse"
    [ "$recover"  = "recover" ] && opts="${opts},recover"

    mkdir -p "$mount_point" || die "Could not create $mount_point"
    exec "$ntfs3g" "$device" "$mount_point" -o "$opts"
}

__rmdir_helper() {
    local mount_point="$1"
    [[ "$mount_point" =~ ^/Volumes/[^/]+$ ]] || die "Refusing: bad mount point '$mount_point'"
    rmdir "$mount_point" 2>/dev/null || true
}

# ── do_mount ─────────────────────────────────────────────────────────────────
do_mount() {
    local disk_id="$1" vol_name="$2" hidden="${3:-}" readonly="${4:-}" rec_file="${5:-$MOUNT_RECORD}"
    local device="/dev/$disk_id"
    local mount_point

    find_ntfs3g &>/dev/null || die "ntfs-3g not found — run: ntfs doctor"

    # If macOS has already auto-mounted the volume (read-only), kick it first.
    # Use 'force' so it works even if Finder has it open. This has to happen
    # *before* get_mount_point: while anything still holds the volume,
    # /Volumes/<name> is occupied, so get_mount_point would skip to <name>_2
    # even though the name is freed a moment later — and the drive shows up in
    # Finder under the wrong name.
    if mount 2>/dev/null | grep -qE "^/dev/$disk_id on "; then
        info "Releasing macOS read-only mount..."
        if ! sudo diskutil unmount force "$disk_id" &>/dev/null; then
            err "Could not release macOS mount on $disk_id — is Finder using it?"
            return 1
        fi
    fi

    mount_point=$(get_mount_point "$vol_name" "$disk_id")
    printf "${BLUE}=>${NC}  Mounting ${BOLD}%s${NC} (%s) → %s\n" "$vol_name" "$disk_id" "$mount_point"

    # Always release Disk Arbitration's hold on the parent disk before opening
    # the raw block device. Without this, ntfs-3g gets EPERM because DA may
    # still hold /dev/diskN open even after the partition is unmounted — and
    # may immediately re-auto-mount the partition read-only behind our backs.
    # No-op if nothing is currently mounted on the parent.
    local parent
    parent=$(echo "$disk_id" | sed 's/s[0-9]*$//; s/p[0-9]*$//')
    if [ "$parent" != "$disk_id" ]; then
        sudo diskutil unmountDisk force "$parent" &>/dev/null || true
    fi

    # ntfs-3g runs as root, so without uid/gid all files appear owned by root and
    # the user can't delete them in Finder. Map files to the invoking user.
    # SUDO_UID is set when called via "sudo ntfs mount"; falls back to id -u
    # when called directly.
    local user_uid user_gid ro_flag=0 nb_flag=0
    user_uid="${SUDO_UID:-$(id -u)}"
    user_gid="${SUDO_GID:-$(id -g)}"
    [ -n "$readonly" ] && ro_flag=1
    [ -n "$hidden" ]   && nb_flag=1

    # First attempt keeps its stderr so a genuine failure isn't masked by the
    # recovery retry, which runs for any failure — not just a dirty volume.
    local first_err recover_err
    if first_err=$(sudo "$SELF" __mount-helper "$device" "$mount_point" \
            "$user_uid" "$user_gid" "$ro_flag" "$nb_flag" "$vol_name" 2>&1 >/dev/null); then
        ok "Mounted ${BOLD}$vol_name${NC} at $mount_point"
        [ -n "$hidden" ] && printf "    ${DIM}Hidden from Finder — Go → Go to Folder (⌘⇧G) → %s${NC}\n" "$mount_point"
        record_mount "$disk_id" "$mount_point" "$rec_file" \
            || warn "Mount succeeded but tracking failed for $disk_id (status/unmount may not see it)"
        return 0
    elif recover_err=$(sudo "$SELF" __mount-helper "$device" "$mount_point" \
            "$user_uid" "$user_gid" "$ro_flag" "$nb_flag" "$vol_name" recover 2>&1 >/dev/null); then
        warn "Mounted ${BOLD}$vol_name${NC} with recovery (volume was not safely ejected from Windows)"
        [ -n "$hidden" ] && printf "    ${DIM}Hidden from Finder — Go → Go to Folder (⌘⇧G) → %s${NC}\n" "$mount_point"
        record_mount "$disk_id" "$mount_point" "$rec_file" \
            || warn "Mount succeeded but tracking failed for $disk_id (status/unmount may not see it)"
        return 0
    else
        err "Failed to mount $vol_name ($disk_id)"
        [ -n "$first_err" ]   && printf "  ntfs-3g: %s\n" "$first_err" >&2
        [ -n "$recover_err" ] && [ "$recover_err" != "$first_err" ] \
            && printf "  ntfs-3g (recover): %s\n" "$recover_err" >&2
        sudo "$SELF" __rmdir-helper "$mount_point" 2>/dev/null || true
        return 1
    fi
}

# ── do_unmount ────────────────────────────────────────────────────────────────
do_unmount() {
    local disk_id="$1" mount_point="$2" eject="${3:-}"

    # If already not mounted, just clean the record — don't report failure
    if ! mount 2>/dev/null | grep -qF " on $mount_point "; then
        warn "$mount_point is not mounted — cleaning stale record"
        record_unmount "$disk_id"
        sudo "$SELF" __rmdir-helper "$mount_point" 2>/dev/null || true
        return 0
    fi

    printf "${BLUE}=>${NC}  Unmounting ${BOLD}%s${NC}...\n" "$mount_point"

    # umount blocks until ntfs-3g FUSE process fully exits — required for eject to work.
    # diskutil unmount force is faster but returns before FUSE teardown, breaking eject.
    if sudo umount "$mount_point" &>/dev/null \
        || sudo diskutil unmount force "$disk_id" &>/dev/null; then
        ok "Unmounted $mount_point"
        sudo "$SELF" __rmdir-helper "$mount_point" 2>/dev/null || true
        record_unmount "$disk_id"

        if [ -n "$eject" ]; then
            local parent
            parent=$(echo "$disk_id" | sed 's/s[0-9]*$//; s/p[0-9]*$//')
            if [ "$parent" != "$disk_id" ] && diskutil info "$parent" &>/dev/null; then
                # Immediately release any Disk Arbitration auto-remounts that
                # race us after umount, then eject to send the spin-down command.
                sudo diskutil unmountDisk force "$parent" &>/dev/null || true
                if sudo diskutil eject "$parent" &>/dev/null; then
                    ok "Ejected ${BOLD}$(basename "$mount_point")${NC} — safe to unplug"
                elif ! diskutil info "$parent" &>/dev/null; then
                    # Disk disappeared — macOS already ejected it
                    ok "Ejected ${BOLD}$(basename "$mount_point")${NC} — safe to unplug"
                else
                    warn "Could not eject $(basename "$mount_point") — unplug manually when the activity light stops"
                fi
            fi
        fi
        return 0
    else
        err "Failed to unmount $mount_point"
        # If an ntfs-3g process is wedged on this device, both umount and
        # diskutil unmount force will block. Surface the PID so the user can
        # kill it manually — kill isn't in the sudoers whitelist on purpose
        # (avoids broadening passwordless root scope).
        local stuck_pid
        stuck_pid=$(pgrep -f "ntfs-3g.*$disk_id" 2>/dev/null | head -1 || true)
        if [ -n "$stuck_pid" ]; then
            printf "  ntfs-3g (PID %s) appears stuck. To force-release: ${BOLD}sudo kill -9 %s${NC}\n" \
                "$stuck_pid" "$stuck_pid" >&2
        fi
        return 1
    fi
}

# ── eject_disk_direct ──────────────────────────────────────────────────────────
# Eject a disk we have no (longer a) mount record for: release any lingering
# FUSE/macOS mount on the partition, then spin the parent disk down. Used by the
# untracked-eject menu and by "ntfs eject <disk>" when the disk isn't tracked.
eject_disk_direct() {
    local disk_id="$1" label="${2:-$1}" parent
    parent=$(echo "$disk_id" | sed 's/s[0-9]*$//; s/p[0-9]*$//')
    printf "${BLUE}=>${NC}  Ejecting ${BOLD}%s${NC}...\n" "$label"
    # umount the partition first — diskutil unmountDisk force can't release a
    # wedged FUSE mount on its own.
    sudo umount "/dev/$disk_id" &>/dev/null || true
    sudo diskutil unmountDisk force "$parent" &>/dev/null || true
    if sudo diskutil eject "$parent" &>/dev/null; then
        ok "Ejected ${BOLD}${label}${NC} — safe to unplug"
    elif ! diskutil info "$parent" &>/dev/null; then
        # Disk disappeared — macOS already ejected it
        ok "Ejected ${BOLD}${label}${NC} — safe to unplug"
    else
        warn "Could not eject ${label} — unplug manually when the activity light stops"
    fi
}

# ── cmd: list ─────────────────────────────────────────────────────────────────
cmd_list() {
    find_ntfs_volumes

    if [ ${#NTFS_DISKS[@]} -eq 0 ]; then
        warn "No NTFS volumes detected. Connect a drive and try again."
        return 0
    fi

    echo
    printf "  ${BOLD}%-14s %-28s %-10s %s${NC}\n" "DISK" "VOLUME" "SIZE" "STATUS"
    printf "  %-14s %-28s %-10s %s\n" \
        "──────────────" "────────────────────────────" "──────────" "──────────────"

    local i disk vol size st status_str
    for i in "${!NTFS_DISKS[@]}"; do
        disk="${NTFS_DISKS[$i]}"; vol="${NTFS_VOLNAMES[$i]}"; size="${NTFS_SIZES[$i]}"
        st=$(mount_status "$disk")
        case "$st" in
            rw) status_str="${GREEN}read-write${NC}" ;;
            ro) status_str="${YELLOW}macOS read-only${NC}" ;;
            *)  status_str="${DIM}not mounted${NC}" ;;
        esac
        printf "  ${CYAN}%-14s${NC} %-28s %-10s " "$disk" "$vol" "$size"
        printf "${status_str}\n"
    done
    echo
}

# ── cmd: status ───────────────────────────────────────────────────────────────
cmd_status() {
    load_mount_record

    if [ ${#REC_DISKS[@]} -eq 0 ]; then
        warn "No NTFS volumes currently mounted via ntfs-handler."
        info "Run ${BOLD}ntfs list${NC} to see available volumes."
        return 0
    fi

    echo
    local i disk mp stale=()
    for i in "${!REC_DISKS[@]}"; do
        disk="${REC_DISKS[$i]}"; mp="${REC_MOUNTS[$i]}"
        if mount 2>/dev/null | grep -qF " on $mp "; then
            printf "  ${GREEN}✓${NC}  ${BOLD}%s${NC}  ${DIM}(%s)${NC}\n" "$mp" "$disk"
        else
            printf "  ${RED}✗${NC}  ${BOLD}%s${NC}  ${DIM}(%s) — stale${NC}\n" "$mp" "$disk"
            stale+=("$disk")
        fi
    done
    echo

    if [ ${#stale[@]} -gt 0 ]; then
        info "Cleaning ${#stale[@]} stale record(s)..."
        local d; for d in "${stale[@]}"; do record_unmount "$d"; done
    fi
}

# ── cmd: mount ────────────────────────────────────────────────────────────────
cmd_mount() {
    local hidden="" all_flag="" readonly="" direct_disks=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --visible|-v)  ;;   # default; kept for backwards compatibility
            --hidden)      hidden="1" ;;
            --all|-a)      all_flag="1" ;;
            --readonly|-r) readonly="1" ;;
            disk*)         direct_disks+=("$1") ;;
            -*)            die "Unknown option: $1" ;;
            *)             die "Unexpected argument: $1" ;;
        esac
        shift
    done

    check_deps || exit 1
    find_ntfs_volumes

    if [ ${#NTFS_DISKS[@]} -eq 0 ]; then
        warn "No NTFS volumes found. Make sure your drive is connected."
        return 1
    fi

    # Direct disk IDs specified on command line
    if [ ${#direct_disks[@]} -gt 0 ]; then
        local target found i
        for target in "${direct_disks[@]}"; do
            found=0
            for i in "${!NTFS_DISKS[@]}"; do
                if [ "${NTFS_DISKS[$i]}" = "$target" ]; then
                    # do_mount prints its own error; swallow rc so set -e doesn't
                    # abort the loop (we still want to process the remaining targets).
                    do_mount "$target" "${NTFS_VOLNAMES[$i]}" "$hidden" "$readonly" || true
                    found=1; break
                fi
            done
            [ "$found" -eq 0 ] && err "Not an NTFS volume: $target"
        done
        return 0
    fi

    # Mount all
    if [ -n "$all_flag" ]; then
        local mounted=0 failed=0 skipped=0 i
        for i in "${!NTFS_DISKS[@]}"; do
            if [ "$(mount_status "${NTFS_DISKS[$i]}")" = "rw" ]; then
                skipped=$((skipped+1))
                continue
            fi
            do_mount "${NTFS_DISKS[$i]}" "${NTFS_VOLNAMES[$i]}" "$hidden" "$readonly" \
                && mounted=$((mounted+1)) || failed=$((failed+1)) || true
        done
        echo
        [ $mounted -gt 0 ] && ok "$mounted volume(s) mounted"
        [ $skipped -gt 0 ] && info "$skipped already mounted read-write — nothing to do"
        [ $failed  -gt 0 ] && warn "$failed volume(s) failed"
        return 0
    fi

    # Interactive
    printf "\n  ${BOLD}NTFS Volumes${NC}\n\n"
    local i disk vol size st st_label
    for i in "${!NTFS_DISKS[@]}"; do
        disk="${NTFS_DISKS[$i]}"; vol="${NTFS_VOLNAMES[$i]}"; size="${NTFS_SIZES[$i]}"
        st=$(mount_status "$disk")
        st_label=""
        [ "$st" = "rw" ] && st_label=" ${GREEN}[mounted rw]${NC}"
        [ "$st" = "ro" ] && st_label=" ${YELLOW}[macOS read-only — will be released]${NC}"
        printf "  ${CYAN}%d)${NC}  %-28s ${DIM}%s, %s${NC}%b\n" \
            $((i+1)) "$vol" "$disk" "$size" "$st_label"
    done
    echo
    printf "  Select volumes to mount (space-separated, 'a' for all): "

    local input choices=()
    read -r input || { warn "Nothing selected."; return 0; }
    if [ "$input" = "a" ] || [ "$input" = "all" ]; then
        for i in "${!NTFS_DISKS[@]}"; do choices+=($((i+1))); done
    else
        read -r -a choices <<< "$input"
    fi

    local mounted=0 failed=0 choice idx
    if [ ${#choices[@]} -eq 0 ]; then
        warn "Nothing selected."
        return 0
    fi
    for choice in "${choices[@]}"; do
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#NTFS_DISKS[@]}" ]; then
            err "Invalid selection: $choice (valid: 1–${#NTFS_DISKS[@]})"
            failed=$((failed+1)); continue
        fi
        idx=$((choice-1))
        if [ "$(mount_status "${NTFS_DISKS[$idx]}")" = "rw" ]; then
            warn "${NTFS_VOLNAMES[$idx]} is already mounted read-write"
            failed=$((failed+1)); continue
        fi
        do_mount "${NTFS_DISKS[$idx]}" "${NTFS_VOLNAMES[$idx]}" "$hidden" "$readonly" \
            && mounted=$((mounted+1)) || failed=$((failed+1)) || true
    done

    echo
    [ $mounted -gt 0 ] && ok "$mounted volume(s) mounted"
    [ $failed  -gt 0 ] && warn "$failed volume(s) failed"
}

# ── cmd: unmount ──────────────────────────────────────────────────────────────
cmd_unmount() {
    local eject="" direct_disks=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --eject|-e) eject="1" ;;
            disk*)      direct_disks+=("$1") ;;
            -*)         die "Unknown option: $1" ;;
            *)          die "Unexpected argument: $1" ;;
        esac
        shift
    done

    load_mount_record

    # Remove stale records before showing the menu
    local i stale=()
    for i in "${!REC_DISKS[@]}"; do
        mount 2>/dev/null | grep -qF " on ${REC_MOUNTS[$i]} " || stale+=("${REC_DISKS[$i]}")
    done
    if [ ${#stale[@]} -gt 0 ]; then
        local d; for d in "${stale[@]}"; do record_unmount "$d"; done
        load_mount_record
    fi

    # Direct disk IDs — handled before the empty-record menu so an explicit
    # target is honored even when it isn't (or is no longer) tracked.
    if [ ${#direct_disks[@]} -gt 0 ]; then
        local target found i
        for target in "${direct_disks[@]}"; do
            found=0
            for i in "${!REC_DISKS[@]}"; do
                if [ "${REC_DISKS[$i]}" = "$target" ]; then
                    do_unmount "$target" "${REC_MOUNTS[$i]}" "$eject" || true
                    found=1; break
                fi
            done
            if [ "$found" -eq 0 ]; then
                if [ -n "$eject" ] && diskutil info "$target" &>/dev/null; then
                    # Not tracked by us, but the user explicitly asked to eject a
                    # real disk — release any lingering mount and spin it down.
                    eject_disk_direct "$target"
                else
                    err "Not in mount record: $target"
                fi
            fi
        done
        return 0
    fi

    if [ ${#REC_DISKS[@]} -eq 0 ]; then
        if [ -n "$eject" ]; then
            # Nothing tracked — but the disk may be spinning with a macOS read-only
            # mount or no mount at all. Offer to eject detected NTFS disks directly.
            find_ntfs_volumes
            if [ ${#NTFS_DISKS[@]} -eq 0 ]; then
                warn "No NTFS volumes detected. Nothing to eject."
                return 0
            fi
            printf "\n  ${BOLD}NTFS Drives${NC}\n\n"
            for i in "${!NTFS_DISKS[@]}"; do
                printf "  ${CYAN}%d)${NC}  %-30s ${DIM}%s  %s${NC}\n" \
                    $((i+1)) "${NTFS_VOLNAMES[$i]}" "${NTFS_DISKS[$i]}" "${NTFS_SIZES[$i]}"
            done
            echo
            printf "  Select drive to eject (or 'a' for all): "
            local input choices=()
            read -r input || { warn "Nothing selected."; return 0; }
            if [ "$input" = "a" ] || [ "$input" = "all" ]; then
                for i in "${!NTFS_DISKS[@]}"; do choices+=($((i+1))); done
            else
                read -r -a choices <<< "$input"
            fi
            local choice idx
            if [ ${#choices[@]} -eq 0 ]; then
                warn "Nothing selected."
                return 0
            fi
            for choice in "${choices[@]}"; do
                if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#NTFS_DISKS[@]}" ]; then
                    err "Invalid selection: $choice"; continue
                fi
                idx=$((choice-1))
                eject_disk_direct "${NTFS_DISKS[$idx]}" "${NTFS_VOLNAMES[$idx]}"
            done
            return 0
        fi
        warn "No mounted NTFS volumes tracked. Nothing to unmount."
        return 0
    fi

    # Interactive
    printf "\n  ${BOLD}Mounted NTFS Volumes${NC}\n\n"
    local i
    for i in "${!REC_DISKS[@]}"; do
        printf "  ${CYAN}%d)${NC}  %-35s ${DIM}(%s)${NC}\n" \
            $((i+1)) "${REC_MOUNTS[$i]}" "${REC_DISKS[$i]}"
    done
    echo
    printf "  Select volumes to unmount (space-separated, 'a' for all): "

    local input choices=()
    read -r input || { warn "Nothing selected."; return 0; }
    if [ "$input" = "a" ] || [ "$input" = "all" ]; then
        for i in "${!REC_DISKS[@]}"; do choices+=($((i+1))); done
    else
        read -r -a choices <<< "$input"
    fi

    local unmounted=0 failed=0 choice idx
    if [ ${#choices[@]} -eq 0 ]; then
        warn "Nothing selected."
        return 0
    fi
    for choice in "${choices[@]}"; do
        if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#REC_DISKS[@]}" ]; then
            err "Invalid selection: $choice (valid: 1–${#REC_DISKS[@]})"
            failed=$((failed+1)); continue
        fi
        idx=$((choice-1))
        do_unmount "${REC_DISKS[$idx]}" "${REC_MOUNTS[$idx]}" "$eject" \
            && unmounted=$((unmounted+1)) || failed=$((failed+1)) || true
    done

    echo
    [ $unmounted -gt 0 ] && ok "$unmounted volume(s) unmounted"
    [ $failed    -gt 0 ] && warn "$failed volume(s) failed"
}

# ── cmd: eject ────────────────────────────────────────────────────────────────
cmd_eject() {
    cmd_unmount --eject "$@"
}

# ── cmd: doctor ───────────────────────────────────────────────────────────────
cmd_doctor() {
    printf "\n${BOLD}ntfs-handler Doctor${NC}\n\n"

    if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then
        printf "  ${GREEN}✓${NC}  Bash %s\n" "$BASH_VERSION"
    else
        printf "  ${YELLOW}▲${NC}  Bash %s — brew install bash recommended\n" "$BASH_VERSION"
    fi

    local ntfs3g_path
    if ntfs3g_path=$(find_ntfs3g); then
        printf "  ${GREEN}✓${NC}  ntfs-3g at %s\n" "$ntfs3g_path"
    else
        printf "  ${RED}✗${NC}  ntfs-3g not found\n"
        printf "       Install: ${BOLD}brew install gromgit/fuse/ntfs-3g-mac${NC}\n"
    fi

    if [ -d /Library/Filesystems/macfuse.fs ] || [ -d /Library/Filesystems/osxfuse.fs ]; then
        printf "  ${GREEN}✓${NC}  macFUSE installed\n"
    else
        printf "  ${RED}✗${NC}  macFUSE not found\n"
        printf "       Install: https://osxfuse.github.io/\n"
    fi

    local sip
    sip=$(csrutil status 2>/dev/null | awk '{print $NF}' | tr -d '.')
    if [ "$sip" = "enabled" ]; then
        printf "  ${YELLOW}▲${NC}  SIP enabled — approve macFUSE in System Settings → Privacy & Security\n"
    else
        printf "  ${GREEN}✓${NC}  SIP: %s\n" "$sip"
    fi

    # Paragon/Tuxera kexts clash with macFUSE and can panic the kernel; surface
    # the conflict here since users only run doctor when something is wrong.
    local conflicting=""
    if kextstat 2>/dev/null | grep -qiE 'paragon|ufsd'; then
        conflicting="${conflicting}Paragon "
    fi
    if kextstat 2>/dev/null | grep -qi tuxera; then
        conflicting="${conflicting}Tuxera "
    fi
    if [ -n "$conflicting" ]; then
        printf "  ${RED}✗${NC}  Conflicting NTFS driver(s) loaded: %s\n" "$conflicting"
        printf "       These clash with macFUSE and can cause kernel panics. Uninstall before use.\n"
    else
        printf "  ${GREEN}✓${NC}  No conflicting NTFS drivers\n"
    fi

    # The agent runs as a user LaunchAgent — root's launchctl can't see it.
    if launchctl print "gui/$(id -u)/com.ntfshandler.automount" &>/dev/null; then
        printf "  ${GREEN}✓${NC}  Auto-mount agent running\n"
    else
        printf "  ${DIM}–${NC}  Auto-mount agent not installed\n"
        printf "       Enable: ${BOLD}ntfs daemon install${NC}\n"
    fi

    find_ntfs_volumes
    printf "\n  NTFS volumes detected: %d\n" "${#NTFS_DISKS[@]}"
    echo
}

# ── cmd: daemon ───────────────────────────────────────────────────────────────
# The auto-mount agent runs as a per-user LaunchAgent so it inherits the user's
# TCC context — LaunchDaemons can't open /dev/disk* on modern macOS without
# manual Full Disk Access grants.
cmd_daemon() {
    local subcmd="${1:-status}"
    shift 2>/dev/null || true

    case "$subcmd" in
        install)
            [ "$(id -u)" -eq 0 ] && die "Don't run with sudo — the agent runs in your user context"

            if [ -f "$DAEMON_OLD_PLIST" ]; then
                err "Old system-wide LaunchDaemon found at $DAEMON_OLD_PLIST"
                printf "  Remove it first: ${BOLD}sudo ntfs daemon uninstall${NC}\n" >&2
                exit 1
            fi

            [ -f /etc/sudoers.d/ntfs-handler ] || die \
                "Passwordless sudo not configured. Run: ntfs install"

            # The agent has no tty — sudo password prompts cannot succeed.
            # The version marker confirms the sudoers file matches what the
            # current agent expects (e.g. /bin/mkdir included).
            local ver_file="${HOME:-/var/root}/.ntfs-handler-sudoers-version"
            local installed_ver=""
            [ -f "$ver_file" ] && installed_ver=$(cat "$ver_file" 2>/dev/null || true)
            if [ "$installed_ver" != "$SUDOERS_VERSION" ]; then
                err "Sudoers rule is from an older version (need v${SUDOERS_VERSION}, have v${installed_ver:-?})"
                printf "  Refresh it: ${BOLD}sudo rm /etc/sudoers.d/ntfs-handler && ntfs install${NC}\n" >&2
                exit 1
            fi

            [ -x /usr/local/bin/ntfs ] || die \
                "/usr/local/bin/ntfs not found. Run: ntfs install"

            info "Installing auto-mount agent..."
            mkdir -p "$(dirname "$DAEMON_PLIST")" "$(dirname "$DAEMON_LOG")"

            cat > "$DAEMON_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ntfshandler.automount</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/ntfs</string>
        <string>__daemon-run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${DAEMON_LOG}</string>
    <key>StandardErrorPath</key>
    <string>${DAEMON_LOG}</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
PLIST

            launchctl bootstrap "gui/$(id -u)" "$DAEMON_PLIST" 2>/dev/null \
                || launchctl load "$DAEMON_PLIST" 2>/dev/null \
                || warn "Could not start agent now — it will start on next login"
            ok "Auto-mount agent installed"
            info "Logs: tail -f $DAEMON_LOG"
            ;;

        uninstall)
            local removed=0
            # New user-scoped agent
            if [ -f "$DAEMON_PLIST" ]; then
                launchctl bootout "gui/$(id -u)/com.ntfshandler.automount" 2>/dev/null \
                    || launchctl unload "$DAEMON_PLIST" 2>/dev/null || true
                rm -f "$DAEMON_PLIST" \
                      "$DAEMON_MOUNT_RECORD" \
                      "${HOME:-/var/root}/Library/Caches/ntfs-daemon-seen" \
                      "$DAEMON_LOG" "$DAEMON_LOG".*
                ok "Auto-mount agent removed"
                removed=1
            fi

            # Legacy system-wide LaunchDaemon (pre-LaunchAgent migration)
            if [ -f "$DAEMON_OLD_PLIST" ]; then
                [ "$(id -u)" -eq 0 ] || die \
                    "Old system-wide LaunchDaemon present — re-run with sudo to remove it"
                launchctl bootout "system/com.ntfshandler.automount" 2>/dev/null \
                    || launchctl unload "$DAEMON_OLD_PLIST" 2>/dev/null || true
                rm -f "$DAEMON_OLD_PLIST" \
                      /var/run/ntfs-daemon-mounts \
                      /var/run/ntfs-daemon-seen \
                      /var/run/ntfs-daemon.pid \
                      /var/log/ntfs-daemon.log
                ok "Legacy system daemon removed"
                removed=1
            fi

            # An if, not "[ … ] && …": as the branch's last statement the
            # latter returns 1 whenever something *was* removed, which breaks
            # the documented "ntfs daemon uninstall && ntfs daemon install".
            if [ "$removed" -eq 0 ]; then
                info "No daemon installed"
            fi
            ;;

        status)
            if launchctl print "gui/$(id -u)/com.ntfshandler.automount" &>/dev/null; then
                ok "Auto-mount agent is ${GREEN}running${NC}"
                info "Logs: tail -f $DAEMON_LOG"
            elif [ -f "$DAEMON_OLD_PLIST" ]; then
                warn "Legacy system daemon installed — run: ${BOLD}sudo ntfs daemon uninstall${NC}"
                printf "  Then: ${BOLD}ntfs daemon install${NC}\n"
            else
                warn "Auto-mount agent is not running"
                printf "  Enable: ${BOLD}ntfs daemon install${NC}\n"
            fi
            ;;

        logs)
            tail -f "$DAEMON_LOG"
            ;;

        *)
            die "Unknown daemon subcommand: $subcmd  (use: install, uninstall, status, logs)"
            ;;
    esac
}

# ── Internal: daemon loop (called by LaunchAgent in user context) ───────────
__daemon_run() {
    local cache_dir="${HOME:-/var/root}/Library/Caches"
    local seen_file="$cache_dir/ntfs-daemon-seen"

    mkdir -p "$cache_dir"
    find_ntfs3g &>/dev/null || { echo "ntfs-3g not found, agent exiting"; exit 1; }

    trap 'exit 0' TERM INT

    # Clear seen_file on every start so drives already plugged in get mounted.
    # Without this, an agent restart (not reboot) would silently skip existing drives.
    : > "$seen_file"
    printf '[%s] ntfs-agent v%s started (PID %d, user %s)\n' \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$VERSION" "$$" "$(id -un)"

    # Per-disk failure counters survive across poll iterations. Parallel arrays
    # because bash 3.2 has no associative arrays.
    local fail_disks=() fail_counts=()
    local max_retries="${NTFS_DAEMON_MAX_RETRIES:-3}"
    # Must be >= 1: 0 would make the give-up test true on the first pass, so
    # every disk would be skipped silently and nothing would ever mount.
    { [[ "$max_retries" =~ ^[0-9]+$ ]] && [ "$max_retries" -ge 1 ]; } || max_retries=3

    while true; do
        # Rotate log at 10 MB so a runaway error loop (or just long uptime)
        # can't fill the disk.
        if [ -f "$DAEMON_LOG" ] && [ "$(stat -f%z "$DAEMON_LOG" 2>/dev/null || echo 0)" -gt 10485760 ]; then
            # Copy-truncate rather than mv: launchd holds this file open for the
            # agent's stdout/stderr, so renaming it leaves launchd writing to the
            # moved inode and never recreates the live log. Truncating in place
            # keeps launchd's (O_APPEND) fd writing to the now-small file.
            cp "$DAEMON_LOG" "${DAEMON_LOG}.$(date +%Y%m%d%H%M%S)" 2>/dev/null && : > "$DAEMON_LOG"
            printf '[%s] Log rotated\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        fi

        local current_disks
        current_disks=$(diskutil list 2>/dev/null \
            | awk '/Microsoft Basic Data|Windows_NTFS/ {print $NF}' | sort || true)

        local failed_this_pass=()

        while IFS= read -r disk_id; do
            [ -z "$disk_id" ] && continue
            grep -qxF "$disk_id" "$seen_file" 2>/dev/null && continue

            # Look up prior failure count
            local count=0 i
            for i in "${!fail_disks[@]}"; do
                [ "${fail_disks[$i]}" = "$disk_id" ] && { count="${fail_counts[$i]}"; break; }
            done

            # Already given up — keep silent until the disk is unplugged
            if [ "$count" -ge "$max_retries" ]; then
                continue
            fi

            local attempt=$((count + 1))
            if [ "$count" -eq 0 ]; then
                printf '[%s] New NTFS volume: %s\n' "$(date '+%H:%M:%S')" "$disk_id"
            fi

            # Skip if already mounted read-write
            if mount 2>/dev/null | grep -E "^/dev/$disk_id on " | grep -qv "read-only"; then
                printf '[%s] %s already mounted rw, skipping\n' "$(date '+%H:%M:%S')" "$disk_id"
                continue
            fi

            local fs_type vol_name
            fs_type=$(diskutil_plist_key "$disk_id" FilesystemType)
            [[ "$fs_type" == *ntfs* ]] || continue

            vol_name=$(diskutil_plist_key "$disk_id" VolumeName)
            if [ -z "$vol_name" ] || [ "$vol_name" = "Not applicable" ]; then
                vol_name="NTFS Volume"
            fi

            # First attempt: surface ntfs-3g's full error. Retries: stay terse —
            # we already printed the diagnostic, no point spamming the log.
            local rc=0
            if [ "$count" -eq 0 ]; then
                do_mount "$disk_id" "$vol_name" "" "" "$DAEMON_MOUNT_RECORD" || rc=$?
            else
                do_mount "$disk_id" "$vol_name" "" "" "$DAEMON_MOUNT_RECORD" >/dev/null 2>&1 || rc=$?
                if [ "$rc" -ne 0 ]; then
                    printf '[%s] %s mount retry %d/%d failed\n' \
                        "$(date '+%H:%M:%S')" "$disk_id" "$attempt" "$max_retries"
                fi
            fi

            if [ "$rc" -eq 0 ]; then
                # Success — drop any failure record
                __daemon_clear_fail "$disk_id"
            else
                failed_this_pass+=("$disk_id")
                __daemon_inc_fail "$disk_id" "$max_retries"
            fi

        done <<< "$current_disks"

        # Write all currently-connected disks as seen.
        printf '%s\n' "$current_disks" > "$seen_file"

        # For disks that failed *and* haven't exhausted retries, remove from
        # seen_file so they're retried next poll. Disks at the give-up threshold
        # stay in seen_file (silent permanent skip).
        if [ ${#failed_this_pass[@]} -gt 0 ]; then
            local fd tmp_seen current_count i
            for fd in "${failed_this_pass[@]}"; do
                current_count=0
                for i in "${!fail_disks[@]}"; do
                    [ "${fail_disks[$i]}" = "$fd" ] && { current_count="${fail_counts[$i]}"; break; }
                done
                if [ "$current_count" -lt "$max_retries" ]; then
                    tmp_seen=$(mktemp)
                    grep -vxF "$fd" "$seen_file" > "$tmp_seen" 2>/dev/null || true
                    mv "$tmp_seen" "$seen_file"
                fi
            done
        fi

        # Garbage-collect failure records for unplugged disks so a re-plug
        # gets a fresh set of attempts.
        __daemon_gc_fails "$current_disks"

        local interval="${NTFS_DAEMON_POLL_INTERVAL:-10}"
        [[ "$interval" =~ ^[0-9]+$ ]] || interval=10
        [ "$interval" -lt 2 ] && interval=2
        sleep "$interval"
    done
}

# Increment failure count for a disk; log "giving up" once the threshold is hit.
# Operates on the fail_disks/fail_counts arrays in __daemon_run's scope.
__daemon_inc_fail() {
    local disk_id="$1" max="$2" i found=0
    for i in "${!fail_disks[@]}"; do
        if [ "${fail_disks[$i]}" = "$disk_id" ]; then
            fail_counts[i]=$((fail_counts[i] + 1))
            found=1
            if [ "${fail_counts[$i]}" -eq "$max" ]; then
                printf '[%s] Giving up on %s after %d attempts. To retry: ntfs mount %s\n' \
                    "$(date '+%H:%M:%S')" "$disk_id" "$max" "$disk_id"
            fi
            break
        fi
    done
    if [ "$found" -eq 0 ]; then
        fail_disks+=("$disk_id")
        fail_counts+=(1)
        if [ "$max" -eq 1 ]; then
            printf '[%s] Giving up on %s after 1 attempt. To retry: ntfs mount %s\n' \
                "$(date '+%H:%M:%S')" "$disk_id" "$disk_id"
        fi
    fi
}

# Drop failure record for a single disk_id.
__daemon_clear_fail() {
    local disk_id="$1" i new_disks=() new_counts=()
    for i in "${!fail_disks[@]}"; do
        if [ "${fail_disks[$i]}" != "$disk_id" ]; then
            new_disks+=("${fail_disks[$i]}")
            new_counts+=("${fail_counts[$i]}")
        fi
    done
    fail_disks=(${new_disks[@]+"${new_disks[@]}"})
    fail_counts=(${new_counts[@]+"${new_counts[@]}"})
}

# Drop failure records for any disk that's no longer in the current disk list.
__daemon_gc_fails() {
    local current="$1" i new_disks=() new_counts=()
    for i in "${!fail_disks[@]}"; do
        if grep -qxF "${fail_disks[$i]}" <<< "$current"; then
            new_disks+=("${fail_disks[$i]}")
            new_counts+=("${fail_counts[$i]}")
        fi
    done
    fail_disks=(${new_disks[@]+"${new_disks[@]}"})
    fail_counts=(${new_counts[@]+"${new_counts[@]}"})
}

# ── cmd: install ──────────────────────────────────────────────────────────────
install_sudoers() {
    local sudoers_file="/etc/sudoers.d/ntfs-handler"
    local ver_file="${HOME:-/var/root}/.ntfs-handler-sudoers-version"

    if [ -f "$sudoers_file" ]; then
        local installed_ver=""
        [ -f "$ver_file" ] && installed_ver=$(cat "$ver_file" 2>/dev/null || true)
        if [ "$installed_ver" != "$SUDOERS_VERSION" ]; then
            warn "Sudoers rule is from an older version (need v${SUDOERS_VERSION}, have v${installed_ver:-?})"
            printf "  Refresh it: ${BOLD}sudo rm /etc/sudoers.d/ntfs-handler && ntfs install${NC}\n" >&2
            return 0
        fi
        ok "Passwordless mounting already configured ($sudoers_file)"
        info "To remove it: sudo rm $sudoers_file"
        return 0
    fi

    echo
    printf "  ${BOLD}Password-free mounting (optional)${NC}\n"
    echo
    printf "  Right now, every time you mount or eject a drive, macOS asks for your\n"
    printf "  password. This is because mounting requires root access.\n"
    echo
    printf "  Saying ${BOLD}yes${NC} adds a rule to /etc/sudoers.d/ntfs-handler that lets\n"
    printf "  ${BOLD}admin${NC} users run only the specific commands ntfs needs (its own\n"
    printf "  validated mount helper, plus diskutil unmount/unmountDisk/eject and\n"
    printf "  umount) without typing a password. Everything else — including\n"
    printf "  ${BOLD}diskutil erase${NC} and ${BOLD}diskutil partition${NC} — still prompts as usual.\n"
    echo
    printf "  ${YELLOW}▲${NC}  ${BOLD}Security note:${NC} any ${BOLD}admin${NC} user on this Mac will be able to unmount\n"
    printf "  and eject any disk without a password, which can interrupt other users'\n"
    printf "  work. Admin users can already reach root with their own password, so this\n"
    printf "  removes the prompt rather than granting new reach — but it also means\n"
    printf "  software running as you can use it without asking. Standard (non-admin)\n"
    printf "  users are not covered by the rule.\n"
    echo
    printf "  Saying ${BOLD}no${NC} changes nothing — you will keep being asked for your password\n"
    printf "  when mounting or ejecting, which is the default macOS behavior.\n"
    echo
    printf "  ${DIM}This is completely reversible: sudo rm /etc/sudoers.d/ntfs-handler${NC}\n"
    echo
    read -rp "  Skip password prompts for ntfs? [y/N] " yn || yn=""
    if [[ ! "${yn:-}" =~ ^[Yy]$ ]]; then
        info "Skipped — you will be prompted for your password when mounting/ejecting"
        return 0
    fi

    # The rule makes root run /usr/local/bin/ntfs without a password, so that
    # path must not be writable by a non-root user.
    if [ "$(stat -f '%u' /usr/local/bin)" -ne 0 ]; then
        err "/usr/local/bin is not root-owned — refusing to install a passwordless rule"
        printf "  Fix with: ${BOLD}sudo chown root:wheel /usr/local/bin${NC}\n" >&2
        return 1
    fi

    local tmp
    tmp=$(mktemp)
    cat > "$tmp" <<'EOF'
# ntfs-handler — allow admin users to run mount/eject commands without a password.
# Installed by: ntfs install
# Remove with:  sudo rm /etc/sudoers.d/ntfs-handler
#
# %admin, not %staff: staff is the default primary group of *every* macOS
# account, including standard users who cannot sudo at all, so %staff would
# hand these commands to users who otherwise have no root access whatsoever.
#
# ntfs-3g is deliberately NOT listed. It mounts "<device|image_file> <dir>",
# so an unrestricted entry would let anyone here mount attacker-supplied
# content over any directory as root. Mounting goes through the root-owned
# /usr/local/bin/ntfs, which validates the device and mount point first.
# That wrapper also creates and removes the mount point, so /bin/mkdir and
# /bin/rmdir are not needed either — their /Volumes/* scope was porous anyway,
# since sudoers wildcards match "/" inside command arguments.
%admin ALL=(root) NOPASSWD: /usr/local/bin/ntfs __mount-helper *, /usr/local/bin/ntfs __rmdir-helper *, /usr/sbin/diskutil unmount force *, /usr/sbin/diskutil unmountDisk force *, /usr/sbin/diskutil eject *, /sbin/umount
EOF

    if ! visudo -c -f "$tmp" &>/dev/null; then
        rm -f "$tmp"
        err "sudoers syntax check failed — skipping"
        return 1
    fi

    sudo cp "$tmp" "$sudoers_file"
    sudo chown root:wheel "$sudoers_file"
    sudo chmod 440 "$sudoers_file"
    rm -f "$tmp"
    # User-readable marker so daemon install can verify the rule version
    # without needing sudo (the sudoers file itself is mode 440).
    printf '%s\n' "$SUDOERS_VERSION" > "$ver_file"
    ok "Passwordless mounting enabled (rule saved to $sudoers_file)"
    info "To remove it later: sudo rm $sudoers_file"
}

cmd_install() {
    local self selfdir
    self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    selfdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    if [ "$self" = /usr/local/bin/ntfs ]; then
        info "ntfs already at /usr/local/bin/ntfs — skipping copy"
    else
        info "Installing ntfs to /usr/local/bin/ntfs..."
        sudo mkdir -p /usr/local/bin
        sudo cp "$self" /usr/local/bin/ntfs
        sudo chown root:wheel /usr/local/bin/ntfs
        sudo chmod 755 /usr/local/bin/ntfs
        ok "Installed!"
    fi

    # zsh completion — /usr/local/share/zsh/site-functions is in zsh's default fpath
    local comp_src="$selfdir/completions/_ntfs"
    local comp_dst="/usr/local/share/zsh/site-functions/_ntfs"
    if [ -f "$comp_src" ]; then
        sudo mkdir -p /usr/local/share/zsh/site-functions
        sudo cp "$comp_src" "$comp_dst"
        ok "zsh completion installed"
        info "Reload your shell or run: autoload -U compinit && compinit"
    else
        info "zsh completion not found — run the curl installer or clone the full repo to get it"
    fi

    # Non-fatal: a declined or failed sudoers step still leaves a working
    # install, just with password prompts.
    install_sudoers || true

    echo
    printf "  ${BOLD}Quick start:${NC}\n"
    printf "  ntfs list                    # see connected NTFS drives\n"
    printf "  ntfs mount                   # interactive mount\n"
    printf "  ntfs mount --all             # mount every detected drive\n"
    printf "  ntfs daemon install          # auto-mount on plug-in\n"
    echo
}

# ── cmd: help ─────────────────────────────────────────────────────────────────
cmd_help() {
    printf "${BOLD}ntfs %s${NC} — Free NTFS read/write for macOS\n" "$VERSION"
    printf "https://github.com/WildBenji/ntfs-handler\n\n"
    printf "Usage: ${BOLD}ntfs${NC} <command> [options]\n\n"
    printf "${BOLD}Commands:${NC}\n"
    printf "  list                         List all NTFS volumes\n"
    printf "  mount   [options] [disk...]  Mount interactively or by disk ID\n"
    printf "  unmount [options] [disk...]  Unmount\n"
    printf "  eject   [options] [disk...]  Unmount and eject physical disk\n"
    printf "  status                       Show mounted volumes (cleans stale records)\n"
    printf "  daemon  <subcommand>         Manage auto-mount daemon\n"
    printf "  doctor                       Check system health and dependencies\n"
    printf "  install                      Install ntfs, zsh completion, and (optionally) passwordless sudoers rule\n\n"
    printf "${BOLD}Mount options:${NC}\n"
    printf "  --hidden         Hide from Finder (default: visible)\n"
    printf "  --readonly, -r   Mount read-only\n"
    printf "  --all, -a        Mount all detected volumes\n\n"
    printf "${BOLD}Note:${NC} volumes mount with Windows filename rules, so names containing\n"
    printf "  ${BOLD}: ? * < > |${NC} or a trailing dot/space cannot be written.\n\n"
    printf "${BOLD}Daemon subcommands:${NC}\n"
    printf "  ntfs daemon install          Enable auto-mount on plug-in\n"
    printf "  ntfs daemon uninstall        Remove auto-mount agent\n"
    printf "  ntfs daemon status           Check if running\n"
    printf "  ntfs daemon logs             Follow logs\n\n"
    printf "${BOLD}Examples:${NC}\n"
    printf "  ntfs list\n"
    printf "  ntfs mount\n"
    printf "  ntfs mount --all\n"
    printf "  ntfs mount disk2s1\n"
    printf "  ntfs eject disk2s1\n"
    printf "  ntfs daemon install\n\n"
}

# ── Main ──────────────────────────────────────────────────────────────────────
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
    list|ls)            cmd_list    "$@" ;;
    mount|m)            cmd_mount   "$@" ;;
    unmount|umount|u)   cmd_unmount "$@" ;;
    eject|e)            cmd_eject   "$@" ;;
    status|st)          cmd_status  "$@" ;;
    daemon)             cmd_daemon  "$@" ;;
    doctor|check)       cmd_doctor  "$@" ;;
    install)            cmd_install "$@" ;;
    __daemon-run)       __daemon_run ;;
    __install-sudoers)  install_sudoers ;;
    __mount-helper)     __mount_helper "$@" ;;
    __rmdir-helper)     __rmdir_helper "$@" ;;
    version|-V|--version) printf "ntfs %s\n" "$VERSION" ;;
    help|-h|--help)     cmd_help ;;
    *)                  err "Unknown command: $cmd"; cmd_help; exit 1 ;;
esac
